---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection } from "astro:content";
const allGallery = (await getCollection("gallery")).sort(
  (a, b) => Number(a.id) - Number(b.id)
);
const filters = [
  "Tất cả",
  ...new Set(allGallery.map((post) => post.data.category)),
];
---

<BaseLayout
  title="Thư viện ảnh — bộ ảnh kỷ yếu, chân dung, dã ngoại | Tiệm Ảnh"
  description="Xem các bộ ảnh Tiệm Ảnh đã chụp: kỷ yếu lớp, sự kiện, chân dung, profile và những chuyến dã ngoại tại Hà Nội."
>
  <section>
    <Wrapper variant="standard" class="py-16 sm:py-24 lg:pt-32">
      <Text
        tag="h1"
        variant="display2XL"
        class="font-extrabold uppercase tracking-tight text-base-950"
      >
        Thư viện ảnh
      </Text>
      <Text tag="p" variant="textLG" class="text-base-600 mt-4 max-w-2xl">
        Một vài bộ ảnh Tiệm đã chụp — kỷ yếu, chân dung và những chuyến đi.
      </Text>

      <!-- Bộ lọc theo dịch vụ -->
      <div
        class="mt-10 flex gap-2 overflow-x-auto scrollbar-hide -mx-4 px-4 md:mx-0 md:px-0 md:flex-wrap"
        id="portfolioFilters"
      >
        {
          filters.map((label, i) => (
            <button
              type="button"
              data-filter={i === 0 ? "all" : label}
              class={`portfolio-filter shrink-0 whitespace-nowrap px-4 py-2 text-xs font-bold uppercase tracking-wide border duration-300 ${
                i === 0
                  ? "bg-base-950 text-white border-base-950"
                  : "bg-white text-base-900 border-base-300 hover:border-base-950"
              }`}
            >
              {label}
            </button>
          ))
        }
      </div>

      <div
        class="mt-10 grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6"
        id="galleryGrid"
      >
        {
          allGallery.map((post) => (
            <article
              class="portfolio-item group relative"
              data-category={post.data.category}
            >
              <a
                href={`/gallery/posts/${post.id}`}
                title={post.data.title}
                class="absolute inset-0 z-10"
              />
              <div class="thumb overflow-hidden aspect-[4/5] bg-base-100">
                <Image
                  src={post.data.thumbnail.url}
                  alt={post.data.thumbnail.alt}
                  width={1200}
                  height={1500}
                  class="size-full object-cover group-hover:scale-105 duration-700 ease-out"
                />
              </div>
              <div class="mt-3">
                <Text
                  tag="h3"
                  variant="textSM"
                  class="font-bold tracking-tight text-base-950 group-hover:underline underline-offset-4 decoration-accent-500 decoration-2"
                >
                  {post.data.title}
                </Text>
                <span class="block mt-1 text-[0.65rem] uppercase tracking-[0.15em] text-base-500">
                  {post.data.category}
                </span>
              </div>
            </article>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<style is:global>
  /* Ảnh nhấn: mở rộng 2 ô để lưới luôn phủ kín (gán bằng JS) */
  #galleryGrid .featured {
    grid-column: span 2 / span 2;
  }
  #galleryGrid .featured .thumb {
    aspect-ratio: 8 / 5;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const grid = document.getElementById("galleryGrid");
    const buttons = document.querySelectorAll(".portfolio-filter");
    const items = [...document.querySelectorAll(".portfolio-item")];
    const activeClasses = ["bg-base-950", "text-white", "border-base-950"];
    const inactiveClasses = ["bg-white", "text-base-900", "border-base-300"];

    // Cân bằng lưới: nếu số ảnh hiện ra không chia hết cho số cột,
    // mở rộng 1–2 ảnh thành 2 ô để không còn ô trống ở hàng cuối.
    function balance() {
      const cols = getComputedStyle(grid).gridTemplateColumns.split(" ").length;
      items.forEach((item) => item.classList.remove("featured"));
      const visible = items.filter((i) => !i.classList.contains("hidden"));
      const spans = (cols - (visible.length % cols)) % cols;
      if (spans >= 1) visible[0]?.classList.add("featured");
      if (spans === 2)
        visible[Math.floor((visible.length + spans) / 2)]?.classList.add(
          "featured"
        );
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach((b) => {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
        });
        button.classList.remove(...inactiveClasses);
        button.classList.add(...activeClasses);
        items.forEach((item) => {
          const show = filter === "all" || item.dataset.category === filter;
          item.classList.toggle("hidden", !show);
        });
        balance();
      });
    });

    let resizeTimer;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(balance, 150);
    });
    balance();
  });
</script>
