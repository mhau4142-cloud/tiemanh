---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout title="Không tìm thấy trang — Tiệm Ảnh">
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-48 text-center items-center justify-center flex flex-col h-full ">
      <Text tag="h1" variant="textBase" class="font-medium text-base-900">
        404 — Không tìm thấy trang này. <a href="/" class="underline underline-offset-4">Về trang chủ</a>
      </Text>
    </Wrapper>
  </section>
</BaseLayout>
