---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogCard from "@/components/blog/BlogCard.astro";
// Data
import { tagLabel } from "@/data/tags";
// Content
import { getCollection } from "astro:content";
const allPosts = (await getCollection("posts")).sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const [featured, ...rest] = allPosts;
---

<BaseLayout
  title="Blog — kinh nghiệm chụp kỷ yếu, chân dung, dã ngoại | Tiệm Ảnh"
  description="Kinh nghiệm từ ekip Tiệm Ảnh: giá chụp kỷ yếu, địa điểm chụp đẹp ở Hà Nội, cách chọn trang phục chụp profile và chuẩn bị cho buổi chụp dã ngoại."
>
  <section>
    <Wrapper variant="standard" class="py-16 sm:py-24 lg:pt-32">
      <Text
        tag="h1"
        variant="display2XL"
        class="font-extrabold uppercase tracking-tight text-base-950"
      >
        Blog
      </Text>
      <Text tag="p" variant="textLG" class="text-base-600 mt-4 max-w-2xl">
        Kinh nghiệm chụp choẹt từ ekip Tiệm — đọc trước khi đặt lịch để buổi
        chụp của bạn đáng tiền nhất.
      </Text>

      {
        featured && (
          <article class="group relative mt-12 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
            <a
              href={`/blog/posts/${featured.id}`}
              title={featured.data.title}
              class="absolute inset-0 z-10"
            />
            <div class="lg:col-span-7 overflow-hidden aspect-[3/2] bg-base-100">
              <Image
                src={featured.data.image.url}
                alt={featured.data.image.alt}
                width={1400}
                height={933}
                loading="eager"
                class="size-full object-cover group-hover:scale-105 duration-700 ease-out"
              />
            </div>
            <div class="lg:col-span-5">
              <div class="flex items-center gap-3 text-[0.65rem] uppercase tracking-[0.15em] text-base-500">
                <span class="bg-accent-400 text-black px-2 py-0.5 font-bold">
                  Mới nhất
                </span>
                <time datetime={new Date(featured.data.pubDate).toISOString()}>
                  {new Date(featured.data.pubDate).toLocaleDateString("vi-VN", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                  })}
                </time>
                <span class="text-accent-600">
                  {tagLabel(featured.data.tags[0])}
                </span>
              </div>
              <Text
                tag="h2"
                variant="displaySM"
                class="mt-3 font-extrabold tracking-tight text-base-950 group-hover:underline underline-offset-4 decoration-accent-500 decoration-2 text-balance"
              >
                {featured.data.title}
              </Text>
              <Text tag="p" variant="textSM" class="mt-3 text-base-600">
                {featured.data.description}
              </Text>
              <span class="mt-5 inline-block text-xs font-bold uppercase tracking-[0.15em] text-base-950 border-b-2 border-accent-400 pb-1">
                Đọc bài →
              </span>
            </div>
          </article>
        )
      }

      <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-12">
        {rest.map((post) => <BlogCard post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
