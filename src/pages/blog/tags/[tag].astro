---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogCard from "@/components/blog/BlogCard.astro";
// Data
import { tagLabel } from "@/data/tags";
// Content
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.tags.includes(tag)
    );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout
  title={`Bài viết chủ đề ${tagLabel(tag)} — Blog Tiệm Ảnh`}
  description={`Các bài viết về ${tagLabel(tag).toLowerCase()} từ ekip Tiệm Ảnh — kinh nghiệm thật từ những buổi chụp thật.`}
>
  <section>
    <Wrapper variant="standard" class="py-16 sm:py-24 lg:pt-32">
      <p class="text-[0.65rem] uppercase tracking-[0.2em] text-base-500">
        ( Chủ đề )
      </p>
      <Text
        tag="h1"
        variant="display2XL"
        class="mt-3 font-extrabold uppercase tracking-tight text-base-950"
      >
        {tagLabel(tag)}
      </Text>
      <div
        class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12"
      >
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
      <a
        href="/blog"
        class="mt-16 inline-block text-xs font-bold uppercase tracking-[0.15em] text-base-950 border-b-2 border-accent-400 pb-1 hover:border-base-950 duration-300"
        >← Tất cả bài viết</a
      >
    </Wrapper>
  </section>
</BaseLayout>
