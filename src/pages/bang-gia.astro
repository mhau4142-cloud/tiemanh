---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data — nguồn giá dùng chung với 3 trang dịch vụ
import { services } from "@/data/services";

const pricingGroups = services.map((service) => ({
  service: service.title,
  slug: service.slug,
  packages: service.packages,
}));

const faqs = [
  {
    question: "Bao lâu thì nhận được ảnh?",
    answer:
      "Ảnh gốc gửi trong 24–48 giờ. Ảnh hậu kỳ trả trong 5–7 ngày tùy số lượng; kỷ yếu số lượng lớn sẽ hẹn rõ ngày khi chốt gói.",
  },
  {
    question: "Có được yêu cầu chỉnh sửa lại không?",
    answer:
      "Có. Mỗi tấm ảnh hậu kỳ được chỉnh lại 1 lần miễn phí nếu bạn chưa ưng — cứ nói thẳng, Tiệm không tự ái.",
  },
  {
    question: "Đặt lịch cần cọc không?",
    answer:
      "Tiệm nhận cọc 30% để giữ lịch. Đổi ngày báo trước 3 ngày thì cọc được bảo lưu.",
  },
  {
    question: "Tiệm có nhận chụp ngoài thành phố không?",
    answer:
      "Có — đây là dịch vụ tủ của Tiệm. Chi phí di chuyển và lưu trú (nếu có) sẽ báo rõ trong báo giá, không phát sinh sau.",
  },
  {
    question: "Trời mưa hoặc lớp đổi lịch thì sao?",
    answer:
      "Buổi chụp ngoài trời gặp thời tiết xấu sẽ được dời miễn phí sang ngày gần nhất mà hai bên cùng rảnh.",
  },
];
---

<BaseLayout
  title="Bảng giá chụp ảnh — kỷ yếu, chân dung, dã ngoại | Tiệm Ảnh"
  description="Bảng giá trọn gói của Tiệm Ảnh Hà Nội: kỷ yếu từ 3,9 triệu/lớp, ảnh thẻ từ 150k, chụp dã ngoại từ 1,8 triệu/buổi. Không phát sinh, báo giá trong ngày."
>
  <section>
    <Wrapper variant="standard" class="py-16 sm:py-24 lg:pt-32">
      <Text
        tag="h1"
        variant="display2XL"
        class="font-extrabold uppercase tracking-tight text-base-950"
      >
        Bảng giá
      </Text>
      <Text tag="p" variant="textLG" class="text-base-600 mt-4 max-w-2xl">
        Giá trọn gói, báo trước khi chụp, không phát sinh lắt nhắt. Cần gói
        riêng? Nhắn Tiệm, báo giá trong ngày.
      </Text>

      {
        pricingGroups.map((group) => (
          <div class="mt-16">
            <div
              class="flex items-end justify-between border-b-2 border-accent-400 pb-3"
            >
              <Text
                tag="h2"
                variant="displaySM"
                class="font-extrabold uppercase tracking-tight text-base-950"
              >
                {group.service}
              </Text>
              <a
                href={`/${group.slug}`}
                class="shrink-0 uppercase text-xs font-medium text-base-900 hover:text-base-600 duration-300 underline underline-offset-4"
                >Về dịch vụ này</a
              >
            </div>
            <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-8">
              {group.packages.map((pkg) => (
                <div class="border border-base-200 p-6 flex flex-col">
                  <Text tag="h3" variant="textBase" class="font-bold uppercase">
                    {pkg.name}
                  </Text>
                  <Text
                    tag="p"
                    variant="textLG"
                    class="font-extrabold text-base-950 mt-2"
                  >
                    {pkg.price}
                  </Text>
                  <ul class="mt-4 space-y-2 text-sm text-base-600 grow">
                    {pkg.includes.map((item) => (
                      <li class="border-l-2 border-accent-400 pl-3">{item}</li>
                    ))}
                  </ul>
                  <div class="mt-6">
                    <Button
                      isLink
                      href="/dat-lich"
                      variant="accent"
                      size="sm"
                      class="w-full"
                    >
                      Đặt gói này
                    </Button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <div class="mt-24">
        <Text
          tag="h2"
          variant="displaySM"
          class="font-extrabold uppercase tracking-tight text-base-950"
        >
          Câu hỏi thường gặp
        </Text>
        <div class="mt-8 divide-y divide-base-200 border-y border-base-200">
          {
            faqs.map((faq) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer items-center justify-between text-sm font-bold uppercase text-base-950 list-none">
                  {faq.question}
                  <span class="text-accent-600 text-xl leading-none group-open:rotate-45 duration-300">
                    +
                  </span>
                </summary>
                <p class="mt-3 text-sm text-base-600 max-w-2xl">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
